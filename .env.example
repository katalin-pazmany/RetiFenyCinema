DATABASE_URL=postgres://retfenymozi:retfenymozi@localhost:5432/retfenymozi
TEST_DATABASE_URL=postgres://retfenymozi:retfenymozi@localhost:5432/retfenymozi_test
TMDB_API_KEY=
OMDB_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
# Sender of the booking confirmation email. Must be an address on a domain
# verified with Resend — Resend rejects sends from unverified domains, and the
# built-in fallback (bookings@retfenymozi.example) sits on an IANA-reserved TLD
# that can never be verified. Leave unset only for local development and tests.
BOOKING_FROM_EMAIL=
# Public base URL for Stripe success/cancel URLs and the cancellation link in
# the confirmation email. Next.js inlines NEXT_PUBLIC_* at build time, so this
# must be set for the build, not just at deploy time. When unset, the app falls
# back to https://$VERCEL_URL on Vercel, then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
